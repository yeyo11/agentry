# Long-lived OAuth token for your Claude subscription.
# Generate it on any machine where you are logged in:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative: pay-per-use API key (leave the OAuth token empty if you use this)
# ANTHROPIC_API_KEY=

# Host port for the API + UI
PORT=8787

# Claude Code version baked into the image. Unset, the Dockerfile's pinned version is used; set an
# exact version to move it, or `latest` / `stable` to give up the pin. The System page tells you when
# a newer one exists. Rebuild after changing it.
# CLAUDE_CODE_VERSION=

# Daily check for a newer Claude Code (reads the npm registry). `off` for an air-gapped install.
# AGENTRY_CLI_UPDATE_CHECK=off

# Authentication for the API. Set these before publishing the port beyond this machine, and for the
# `tls` compose profile (docker compose --profile tls up -d).
# AGENTRY_AUTH_MODE=token
# AGENTRY_AUTH_TOKEN=
# Lost the token and cannot reach the data volume? Set a new AGENTRY_AUTH_TOKEN, add this and restart:
# the new value replaces the stored one (the audit log records it with actor `env`). A value already
# applied is not applied again, so leaving it set does not undo a token rotated later.
# AGENTRY_AUTH_TOKEN_RESET=1
# Public name the `tls` profile serves (a real name gets a Let's Encrypt certificate)
# AGENTRY_DOMAIN=agentry.example.com

# Consecutive failed health probes (30 s apart) after which the container restarts itself
# AGENTRY_HEALTH_RESTART_AFTER=3

# claude-swap version baked into the image (empty = latest). Multi-account rotation.
# CLAUDE_SWAP_VERSION=

# claude-swap binary. With accounts registered it owns the credential and the token above is ignored.
# CSWAP_BIN=cswap

# Permission mode for runs that do not specify one.
# The container is the sandbox, so the image defaults to bypassPermissions.
# AGENTRY_DEFAULT_PERMISSION_MODE=bypassPermissions

# Max simultaneous `claude` processes
# AGENTRY_MAX_CONCURRENT_RUNS=8
