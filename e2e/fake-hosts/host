#!/bin/sh
# One script behind the two names, gh and glab: the name it is called by picks its state file and its
# dialect. They answer only what the Integrations page, a project's readiness and the change request
# flow ask. See README.md.
name=$(basename "$0")
dir="${AGENTRY_DATA_DIR:-.}/fake-hosts"
file="$dir/$name.json"

read_key() {
  [ -f "$file" ] || return 0
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" "$file" | head -n 1
}

# The value after a flag
flag() {
  want="$1"; shift
  while [ $# -gt 0 ]; do
    if [ "$1" = "$want" ]; then echo "$2"; return; fi
    shift
  done
}

# Every call is written down, one line, for a spec that wants to see what was asked
mkdir -p "$dir"
echo "$*" >> "$dir/$name.calls"

case "$name" in
  gh) default_version=2.92.0 ;;
  glab) default_version=1.120.0 ;;
esac
version=$(read_key version)
version=${version:-$default_version}
signed_in=$(read_key signedIn)
user=$(read_key user)
branch=$(read_key defaultBranch)
branch=${branch:-main}
# The number the next change request gets, and the CI and state the open one reports
next=$(cat "$dir/$name.next" 2>/dev/null || read_key next)
next=${next:-7}
ci=$(read_key ci)
ci=${ci:-none}
mr_state=$(read_key state)
mr_state=${mr_state:-open}
# The checks of the open change request, for the change request routes: none, failing, running,
# mixed or fixed. A rerun or a cancel the CLI is asked for moves them (the .checks file wins over the
# JSON), which is what a spec then sees on its next read
checks=$(cat "$dir/$name.checks" 2>/dev/null || read_key checks)
checks=${checks:-none}
head_sha=$(read_key headSha)
head_sha=${head_sha:-a1b2c3d4e5f60718293a4b5c6d7e8f9012345678}

# The review scenario, for the review routes: none, threads (three threads, a comment review waiting,
# a review still required) or changes (the same, with a request for changes on record). What a spec
# does to the host through the CLI moves it: replies, resolves and the reviewers asked for are kept
# beside the JSON, so the next read shows them.
reviews=$(read_key reviews)
reviews=${reviews:-none}
pending_review=$(read_key pendingReview)

# Three review threads, as both hosts print them: an open one with a suggestion on src/cart.ts line 12,
# a resolved one on README.md, and an outdated one whose line moved, with a body that tries HTML
THREAD_1=PRRT_kwDOe2e0001
THREAD_2=PRRT_kwDOe2e0002
THREAD_3=PRRT_kwDOe2e0003
GL_1=1111111111111111111111111111111111111111
GL_2=2222222222222222222222222222222222222222
GL_3=3333333333333333333333333333333333333333
BODY_1='"Round half up here: a float total prints 10.01.\n\n```suggestion\n  return Math.round(total * 100) / 100;\n```"'
BODY_2='"The heading reads fine now."'
BODY_3='"Keep the old helper <img src=x onerror=\"window.__pwned=1\"> **as it was** please"'

# "resolved" or "open": what a resolve or a reopen last said wins over the scenario's own state
thread_state() {
  last=$(grep "^$1 " "$dir/$name.threadstate" 2>/dev/null | tail -n 1 | cut -d' ' -f2)
  echo "${last:-$2}"
}

# The replies a spec posted to a thread, as comments: "<root id> <JSON string>" per line
reply_nodes() {
  n=0
  grep "^$1 " "$dir/$name.replies" 2>/dev/null | cut -d' ' -f2- | while IFS= read -r reply_body; do
    n=$((n + 1))
    if [ "$name" = gh ]; then
      printf ',{"id":"PRRC_reply%s","databaseId":%s,"body":%s,"author":{"login":"%s"},"createdAt":"2026-10-01T10:30:00Z","outdated":false,"diffHunk":"","replyTo":null}' "$n" "$((6000 + n))" "$reply_body" "${user:-octocat}"
    else
      printf ',{"id":%s,"author":{"username":"%s"},"body":%s,"created_at":"2026-10-01T10:30:00Z","system":false,"position":null,"suggestions":null}' "$((6000 + n))" "${user:-tanuki}" "$reply_body"
    fi
  done
}

# ---- gh: the review threads, the reviewers and the reviews ----
gh_thread() {
  # node id, database id, scenario state, outdated, line, original line, body, author
  resolved=false
  [ "$(thread_state "$1" "$3")" = resolved ] && resolved=true
  if [ "$4" = true ]; then line=null; else line=$5; fi
  if [ "$resolved" = true ]; then by='{"login":"hubot"}'; else by=null; fi
  path=src/cart.ts
  [ "$1" = "$THREAD_2" ] && path=README.md
  printf '{"id":"%s","isResolved":%s,"isOutdated":%s,"path":"%s","line":%s,"originalLine":%s,"startLine":null,"originalStartLine":null,"diffSide":"RIGHT","startDiffSide":null,"subjectType":"LINE","resolvedBy":%s,"viewerCanResolve":true,"viewerCanUnresolve":true,"viewerCanReply":true,"comments":{"totalCount":1,"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[{"id":"PRRC_%s","databaseId":%s,"body":%s,"author":{"login":"%s"},"createdAt":"2026-10-01T10:00:00Z","outdated":%s,"diffHunk":"@@ -10,3 +10,3 @@ export function total(items) {\\n-  return sum;\\n+  return sum / 100;\\n }","replyTo":null,"pullRequestReview":{"databaseId":9000,"state":"COMMENTED"}}%s]}}' \
    "$1" "$resolved" "$4" "$path" "$line" "$6" "$by" "$1" "$2" "$7" "$8" "$4" "$(reply_nodes "$2")"
}

threads_json() {
  nodes=""
  count=0
  if [ "$reviews" != none ]; then
    nodes="$(gh_thread $THREAD_1 5001 open false 12 12 "$BODY_1" hubot),$(gh_thread $THREAD_2 5002 resolved false 1 1 "$BODY_2" hubot),$(gh_thread $THREAD_3 5003 open true 20 20 "$BODY_3" hubot)"
    count=3
  fi
  printf 'HTTP/2.0 200 OK\r\nx-ratelimit-remaining: 4990\r\n\r\n'
  printf '{"data":{"rateLimit":{"cost":1,"remaining":4990,"resetAt":"2026-10-01T11:00:00Z","used":10},"repository":{"pullRequest":{"headRefOid":"%s","reviewThreads":{"totalCount":%s,"pageInfo":{"hasNextPage":false,"endCursor":"Y3Vyc29yOjM="},"nodes":[%s]}}}}}\n' "$head_sha" "$count" "$nodes"
}

# resolve (true) or reopen (false) the thread named by -F id=
thread_mutation() {
  want="$1"; shift
  id=$(echo "$*" | sed -n 's/.*-F id=\([A-Za-z0-9_=-]*\).*/\1/p')
  if [ "$want" = true ]; then st=resolved; verb=resolve; else st=open; verb=unresolve; fi
  echo "$id $st" >> "$dir/$name.threadstate"
  printf '{"data":{"%sReviewThread":{"thread":{"id":"%s","isResolved":%s}}}}\n' "$verb" "$id" "$want"
}

# The requested reviewers: the scenario's own first, then whoever a spec asked for
requested_json() {
  list="$1"
  for who in $(cat "$dir/$name.requested" 2>/dev/null); do
    if [ -n "$list" ]; then list="$list,{\"login\":\"$who\"}"; else list="{\"login\":\"$who\"}"; fi
  done
  echo "$list"
}

pr_reviews_json() {
  case "$reviews" in
    threads) decision='"REVIEW_REQUIRED"'; given='[{"author":{"login":"hubot"},"state":"COMMENTED"}]'; first='{"login":"monalisa"}' ;;
    changes) decision='"CHANGES_REQUESTED"'; given='[{"author":{"login":"hubot"},"state":"CHANGES_REQUESTED"}]'; first='{"login":"monalisa"}' ;;
    *) decision='""'; given='[]'; first='' ;;
  esac
  printf '{"reviewDecision":%s,"reviewRequests":[%s],"reviews":%s}\n' "$decision" "$(requested_json "$first")" "$given"
}

# ---- glab: the discussions, the approvals and the reviewers ----
glab_discussion() {
  # discussion id (40 hex), scenario state, new line, head sha the note was left on, body
  resolved=false
  [ "$(thread_state "$1" "$2")" = resolved ] && resolved=true
  path=src/cart.ts
  [ "$1" = "$GL_2" ] && path=README.md
  if [ "$1" = "$GL_1" ]; then
    suggestions='[{"from_line":12,"to_line":12,"from_content":"  return sum / 100;","to_content":"  return Math.round(total * 100) / 100;","appliable":true,"applied":false}]'
  else
    suggestions='[]'
  fi
  printf '{"id":"%s","individual_note":false,"resolvable":true,"resolved":%s,"notes":[{"id":%s,"type":"DiffNote","author":{"username":"hubot"},"body":%s,"created_at":"2026-10-01T10:00:00Z","system":false,"resolved_by":%s,"position":{"new_path":"%s","old_path":"%s","new_line":%s,"old_line":null,"head_sha":"%s","line_range":null},"suggestions":%s}%s]}\n' \
    "$1" "$resolved" "$6" "$5" "$( [ "$resolved" = true ] && echo '{"username":"hubot"}' || echo null )" "$path" "$path" "$3" "$4" "$suggestions" "$(reply_nodes "$1")"
}

discussions_ndjson() {
  [ "$reviews" = none ] && return
  glab_discussion "$GL_1" open 12 "$head_sha" "$BODY_1" 5001
  glab_discussion "$GL_2" resolved 1 "$head_sha" "$BODY_2" 5002
  # Left on another commit than the head: the thread is outdated
  glab_discussion "$GL_3" open 20 0000000000000000000000000000000000000000 "$BODY_3" 5003
}

# The viewer has approved once `mr approve` ran; the rule wants one approval
approvals_json() {
  if [ -f "$dir/glab.approved" ]; then
    printf '{"approved":true,"approvals_required":1,"approvals_left":0,"user_has_approved":true,"approved_by":[{"user":{"username":"%s"}}]}\n' "${user:-tanuki}"
  else
    echo '{"approved":false,"approvals_required":1,"approvals_left":1,"user_has_approved":false,"approved_by":[]}'
  fi
}

glab_reviewers_json() {
  list=""
  case "$reviews" in
    threads) list='{"user":{"username":"hubot"},"state":"reviewed"},{"user":{"username":"monalisa"},"state":"unreviewed"}' ;;
    changes) list='{"user":{"username":"hubot"},"state":"requested_changes"},{"user":{"username":"monalisa"},"state":"unreviewed"}' ;;
  esac
  for who in $(cat "$dir/$name.requested" 2>/dev/null); do
    if [ -n "$list" ]; then list="$list,{\"user\":{\"username\":\"$who\"},\"state\":\"unreviewed\"}"; else list="{\"user\":{\"username\":\"$who\"},\"state\":\"unreviewed\"}"; fi
  done
  echo "[$list]"
}

# The repository a -R names, as a web address
repo_url() {
  r=$(flag -R "$@")
  case "$r" in http*) echo "$r" ;; *) echo "https://$r" ;; esac
}

# ---- gh: the checks of a head commit, as the REST and GraphQL answers print them ----
check_run() {
  # id name status conclusion app
  if [ -n "$4" ]; then conclusion="\"$4\""; else conclusion=null; fi
  if [ "$3" = completed ]; then done_at='"2026-10-01T09:53:12Z"'; else done_at=null; fi
  printf '{"id":%s,"name":"%s","status":"%s","conclusion":%s,"app":{"slug":"%s"},"html_url":"https://github.com/acme/shop/actions/runs/900/job/%s","started_at":"2026-10-01T09:50:00Z","completed_at":%s}' \
    "$1" "$2" "$3" "$conclusion" "$5" "$1" "$done_at"
}

check_runs_json() {
  case "$checks" in
    failing) list="$(check_run 1001 lint completed success github-actions),$(check_run 1002 unit completed failure github-actions),$(check_run 1003 build completed success github-actions)"; total=3 ;;
    running) list="$(check_run 1001 lint completed success github-actions),$(check_run 1003 e2e in_progress '' github-actions),$(check_run 1004 build queued '' github-actions)"; total=3 ;;
    mixed) list="$(check_run 1001 lint completed success github-actions),$(check_run 1002 unit completed failure github-actions),$(check_run 1003 e2e in_progress '' github-actions),$(check_run 1004 docs completed skipped github-actions),$(check_run 1005 coverage completed success codecov)"; total=5 ;;
    fixed) list="$(check_run 1001 lint completed success github-actions),$(check_run 1002 unit completed success github-actions),$(check_run 1003 build completed success github-actions)"; total=3 ;;
    *) list=""; total=0 ;;
  esac
  printf '[{"total_count":%s,"check_runs":[%s]}]\n' "$total" "$list"
}

# What the GraphQL read says of the head commit's rollup, in the shape the CI badge reads
rollup_nodes() {
  case "$checks" in
    failing|mixed) echo '{"__typename":"CheckRun","name":"unit","status":"COMPLETED","conclusion":"FAILURE"}' ;;
    running) echo '{"__typename":"CheckRun","name":"e2e","status":"IN_PROGRESS","conclusion":null}' ;;
    fixed) echo '{"__typename":"CheckRun","name":"unit","status":"COMPLETED","conclusion":"SUCCESS"}' ;;
  esac
}

change_request_json() {
  nodes=$(rollup_nodes)
  rollup=null
  [ -n "$nodes" ] && rollup="{\"state\":\"PENDING\",\"contexts\":{\"nodes\":[$nodes],\"pageInfo\":{\"hasNextPage\":false}}}"
  case "$mr_state" in merged) st=MERGED; at='"2026-10-01T10:00:00Z"' ;; closed) st=CLOSED; at=null ;; *) st=OPEN; at=null ;; esac
  number=$(echo "$*" | sed -n 's/.*number=\([0-9]*\).*/\1/p')
  printf 'HTTP/2.0 200 OK\r\nx-ratelimit-remaining: 4990\r\n\r\n'
  printf '{"data":{"repository":{"pullRequest":{"number":%s,"url":"https://github.com/acme/shop/pull/%s","state":"%s","mergedAt":%s,"isDraft":false,"headRefOid":"%s","baseRefName":"main","mergeable":"MERGEABLE","mergeStateStatus":"CLEAN","reviewDecision":null,"autoMergeRequest":null,"commits":{"nodes":[{"commit":{"statusCheckRollup":%s}}]}}},"rateLimit":{"cost":1,"remaining":4990,"resetAt":"2026-10-01T11:00:00Z"}}}\n' "${number:-7}" "${number:-7}" "$st" "$at" "$head_sha" "$rollup"
}

# The failed job prints what a runner prints: ANSI colour, a group marker, the error line
job_log() {
  printf '2026-10-01T09:50:01Z \033[36;1m##[group]Run pnpm test\033[0m\n'
  printf '2026-10-01T09:50:02Z \033[90m$ node --test test/*.test.ts\033[0m\n'
  printf '2026-10-01T09:50:09Z ok 41 - cart totals\n'
  printf '2026-10-01T09:50:10Z \033[31mnot ok 42 - cart rounds half up\033[0m\n'
  printf '2026-10-01T09:50:10Z   AssertionError: expected 10.01 to equal 10.02\n'
  printf '2026-10-01T09:50:11Z \033[31;1m##[error]Process completed with exit code 1.\033[0m\n'
}

# Only the failed run carries annotations: once it passes (same id, as the fixed scenario keeps it)
# a real host has none for it
annotations_json() {
  case "$checks" in failing|mixed) ;; *) echo '[]'; return ;; esac
  echo '[{"path":".github","start_line":1,"end_line":1,"annotation_level":"failure","title":null,"message":"Process completed with exit code 1."},{"path":"src/cart.ts","start_line":12,"end_line":12,"annotation_level":"failure","title":"cart rounds half up","message":"expected 10.01 to equal 10.02"}]'
}

version_out() {
  code=$(read_key versionExit)
  if [ -n "$code" ] && [ "$code" != 0 ]; then echo "fake $name: broken" >&2; exit "$code"; fi
  case "$name" in
    gh) printf 'gh version %s (2026-04-28)\nhttps://github.com/cli/cli/releases/tag/v%s\n' "$version" "$version" ;;
    glab) printf 'glab %s (fake)\n' "$version" ;;
  esac
  exit 0
}

case "$name" in
  gh)
    case "$1" in
      --version) version_out ;;
      auth)
        # One call lists every host and exits 0 whatever the token's state, as 2.92 does
        if [ "$signed_in" = false ]; then echo '{"hosts":{}}'; exit 0; fi
        printf '{"hosts":{"github.com":[{"state":"success","active":true,"host":"github.com","login":"%s","tokenSource":"keyring","gitProtocol":"https"}]}}\n' "${user:-octocat}"
        exit 0 ;;
      api)
        case "$*" in
          *unresolveReviewThread*) thread_mutation false "$@"; exit 0 ;;
          *resolveReviewThread*) thread_mutation true "$@"; exit 0 ;;
          *'reviewThreads(first'*) threads_json; exit 0 ;;
          *graphql*) change_request_json "$@"; exit 0 ;;
          */pulls/*/comments/*/replies*)
            root=$(echo "$*" | sed -n 's#.*/comments/\([0-9]*\)/replies.*#\1#p')
            # printf, not echo: a dash echo turns the \n of the JSON string into a line break
            printf '%s %s\n' "$root" "$(cat | sed -n 's/^{"body":\(.*\)}$/\1/p')" >> "$dir/gh.replies"
            printf '{"id":6000}\n'; exit 0 ;;
          */pulls/*/requested_reviewers*)
            # The author cannot be asked (a 422 that names it); an unknown login exits 0 and adds nobody
            for who in $(cat | grep -o '"[A-Za-z0-9][A-Za-z0-9-]*"' | tr -d '"' | grep -v '^reviewers$'); do
              if [ "$who" = "${user:-octocat}" ]; then
                echo '{"message":"Review cannot be requested from pull request author.","status":"422"}'
                echo "gh: Review cannot be requested from pull request author. (HTTP 422)" >&2
                exit 1
              fi
              case "$who" in ghost*) ;; *) echo "$who" >> "$dir/gh.requested" ;; esac
            done
            echo '{}'; exit 0 ;;
          */pulls/*/reviews*)
            case "$*" in
              *"-X POST"*)
                k=$(cat "$dir/gh.reviews-posted" 2>/dev/null || echo 0)
                k=$((k + 1))
                echo "$k" > "$dir/gh.reviews-posted"
                cat > "$dir/gh.review-$k"
                printf '{"id":%s,"state":"COMMENTED"}\n' "$((9000 + k))"; exit 0 ;;
            esac
            # A review of the person's own that is still pending is in the way of a post
            if [ "$pending_review" = true ]; then echo '[[{"id":8001,"state":"PENDING","body":"","user":{"login":"octocat"}}]]'; else echo '[[]]'; fi
            exit 0 ;;
          */check-runs/*/annotations*) annotations_json; exit 0 ;;
          */check-runs\?*) check_runs_json; exit 0 ;;
          */commits/*/status\?*) echo '[{"statuses":[]}]'; exit 0 ;;
          */actions/jobs/*/logs) job_log; exit 0 ;;
          */rules/branches/*) echo '[]'; exit 0 ;;
          */branches/*) echo '{"protected":false}'; exit 0 ;;
        esac
        printf '{"default_branch":"%s","private":true}\n' "$branch"; exit 0 ;;
      run)
        # A rerun starts the checks again, a cancel leaves the failure standing
        case "$2" in
          rerun) echo running > "$dir/gh.checks"; exit 0 ;;
          cancel) echo failing > "$dir/gh.checks"; exit 0 ;;
        esac ;;
      pr)
        case "$2" in
          create)
            cat > "$dir/gh.body-$next"
            echo "$next" > "$dir/gh.created"
            echo $((next + 1)) > "$dir/gh.next"
            echo "$(repo_url "$@")/pull/$next"; exit 0 ;;
          list)
            n=$(cat "$dir/gh.created" 2>/dev/null)
            if [ -n "$n" ]; then printf '[{"number":%s,"url":"%s/pull/%s","state":"OPEN","headRefName":"x","baseRefName":"x","isCrossRepository":false}]\n' "$n" "$(repo_url "$@")" "$n"
            else echo '[]'; fi
            exit 0 ;;
          view)
            case "$*" in *reviewRequests*) pr_reviews_json; exit 0 ;; esac
            case "$ci" in passing) roll='[{"status":"COMPLETED","conclusion":"SUCCESS"}]' ;; failing) roll='[{"status":"COMPLETED","conclusion":"FAILURE"}]' ;; pending) roll='[{"status":"IN_PROGRESS","conclusion":""}]' ;; *) roll='[]' ;; esac
            case "$mr_state" in merged) st=MERGED; at='"2026-10-01T10:00:00Z"' ;; closed) st=CLOSED; at=null ;; *) st=OPEN; at=null ;; esac
            printf '{"state":"%s","mergedAt":%s,"statusCheckRollup":%s,"url":"%s/pull/%s"}\n' "$st" "$at" "$roll" "$(repo_url "$@")" "$3"; exit 0 ;;
        esac ;;
    esac ;;
  glab)
    case "$1 $2" in
      "version "*|"--version "*) version_out ;;
      "auth status")
        if [ "$signed_in" = false ]; then echo "x No token found" >&2; exit 1; fi
        echo "Logged in to $(flag --hostname "$@") as ${user:-tanuki} (fake)" >&2; exit 0 ;;
      "repo view") printf '{"default_branch":"%s","visibility":"private"}\n' "$branch"; exit 0 ;;
      "mr create")
        cat > "$dir/glab.body-$next"
        echo "$next" > "$dir/glab.created"
        echo $((next + 1)) > "$dir/glab.next"
        echo "$(repo_url "$@")/-/merge_requests/$next"; exit 0 ;;
      "mr list")
        n=$(cat "$dir/glab.created" 2>/dev/null)
        if [ -n "$n" ]; then printf '[{"iid":%s,"web_url":"%s/-/merge_requests/%s","state":"opened"}]\n' "$n" "$(repo_url "$@")" "$n"
        else echo '[]'; fi
        exit 0 ;;
      "mr view")
        case "$ci" in none) pipe=null ;; passing) pipe='{"status":"success"}' ;; failing) pipe='{"status":"failed"}' ;; *) pipe='{"status":"running"}' ;; esac
        case "$mr_state" in merged) st=merged; at='"2026-10-01T10:00:00Z"' ;; closed) st=closed; at=null ;; *) st=opened; at=null ;; esac
        printf '{"iid":%s,"web_url":"%s/-/merge_requests/%s","state":"%s","merged_at":%s,"head_pipeline":%s,"sha":"%s","target_branch":"main","diff_refs":{"base_sha":"%s","start_sha":"%s","head_sha":"%s"}}\n' "$3" "$(repo_url "$@")" "$3" "$st" "$at" "$pipe" "$head_sha" "$head_sha" "$head_sha" "$head_sha"; exit 0 ;;
      "mr approve") touch "$dir/glab.approved"; echo "- Approving merge request !$3"; exit 0 ;;
      "mr revoke") rm -f "$dir/glab.approved"; echo "- Revoking approval for merge request !$3"; exit 0 ;;
      "mr update")
        # --reviewer=+name adds one name, --reviewer=-name takes one off; an unknown user fails in glab
        case "$*" in
          *--reviewer=+ghost*) echo "glab: 404 user not found" >&2; exit 1 ;;
          *--reviewer=+*) echo "$(echo "$*" | sed -n 's/.*--reviewer=+\([A-Za-z0-9._-]*\).*/\1/p')" >> "$dir/glab.requested" ;;
          *--reviewer=-*) who=$(echo "$*" | sed -n 's/.*--reviewer=-\([A-Za-z0-9._-]*\).*/\1/p'); grep -v "^$who\$" "$dir/glab.requested" > "$dir/glab.requested.tmp" 2>/dev/null; mv "$dir/glab.requested.tmp" "$dir/glab.requested" 2>/dev/null ;;
        esac
        exit 0 ;;
      "mr note")
        case "$3" in
          resolve) echo "$5 resolved" >> "$dir/glab.threadstate"; exit 0 ;;
          reopen) echo "$5 open" >> "$dir/glab.threadstate"; exit 0 ;;
          publish) exit 0 ;;
        esac ;;
      "api "*)
        case "$*" in
          */discussions/*/notes*)
            root=$(echo "$*" | sed -n 's#.*/discussions/\([0-9a-f]*\)/notes.*#\1#p')
            printf '%s %s\n' "$root" "$(cat | sed -n 's/^{"body":\(.*\)}$/\1/p')" >> "$dir/glab.replies"
            printf '{"id":6000}\n'; exit 0 ;;
          */discussions*) discussions_ndjson; exit 0 ;;
          */approvals*) approvals_json; exit 0 ;;
          */reviewers*) glab_reviewers_json; exit 0 ;;
          */draft_notes*) echo '[]'; exit 0 ;;
        esac ;;
    esac ;;
esac
echo "fake $name: $* is not part of the fake" >&2
exit 1
