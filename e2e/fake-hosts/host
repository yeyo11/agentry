#!/bin/sh
# One script behind the two names, gh and glab: the name it is called by picks its state file and its
# dialect. They answer only what the Integrations page, a project's readiness and the change request
# flow ask. See README.md.
name=$(basename "$0")
dir="${AGENTRY_DATA_DIR:-.}/fake-hosts"
file="$dir/$name.json"

read_key() {
  [ -f "$file" ] || return 0
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" "$file" | head -n 1
}

# The value after a flag
flag() {
  want="$1"; shift
  while [ $# -gt 0 ]; do
    if [ "$1" = "$want" ]; then echo "$2"; return; fi
    shift
  done
}

# Every call is written down, one line, for a spec that wants to see what was asked
mkdir -p "$dir"
echo "$*" >> "$dir/$name.calls"

case "$name" in
  gh) default_version=2.92.0 ;;
  glab) default_version=1.120.0 ;;
esac
version=$(read_key version)
version=${version:-$default_version}
signed_in=$(read_key signedIn)
user=$(read_key user)
branch=$(read_key defaultBranch)
branch=${branch:-main}
# The number the next change request gets, and the CI and state the open one reports
next=$(cat "$dir/$name.next" 2>/dev/null || read_key next)
next=${next:-7}
ci=$(read_key ci)
ci=${ci:-none}
mr_state=$(read_key state)
mr_state=${mr_state:-open}
# The checks of the open change request, for the change request routes: none, failing, running,
# mixed or fixed. A rerun or a cancel the CLI is asked for moves them (the .checks file wins over the
# JSON), which is what a spec then sees on its next read
checks=$(cat "$dir/$name.checks" 2>/dev/null || read_key checks)
checks=${checks:-none}
head_sha=$(read_key headSha)
head_sha=${head_sha:-a1b2c3d4e5f60718293a4b5c6d7e8f9012345678}
# A merge the CLI took (`pr merge`, `mr merge`) leaves the change request merged for every read after it
# It is merged for the number that was merged, not for every change request the fake serves: a spec merges one
# and the pacer reads the others. A call that names no number (a list) sees it as merged, as before.
if [ -f "$dir/$name.merged" ]; then
  asked=$(echo "$*" | sed -n 's/.*\(pr\|mr\) \(view\|merge\) \([0-9][0-9]*\).*/\3/p; t; s/.*number=\([0-9][0-9]*\).*/\1/p; t; s/.*merge_requests\/\([0-9][0-9]*\).*/\1/p')
  merged_of=$(cat "$dir/$name.merged-of" 2>/dev/null)
  if [ -z "$asked" ] || [ -z "$merged_of" ] || [ "$asked" = "$merged_of" ]; then mr_state=merged; fi
fi

# The merge scenario, for the merge routes. Auto-merge armed is a method name kept beside the JSON
# (`<name>.armed`, written by the arming call, removed by the disarm; the JSON's `armed` seeds it)
armed_method() {
  cat "$dir/$name.armed" 2>/dev/null || read_key armed
}

# "true" or "false": whether the repository allows a method (`methods`, a space separated list)
allows() {
  list=$(read_key methods)
  list=${list:-squash merge rebase}
  case " $list " in *" $1 "*) echo true ;; *) echo false ;; esac
}

# The review scenario, for the review routes: none, threads (three threads, a comment review waiting,
# a review still required) or changes (the same, with a request for changes on record). What a spec
# does to the host through the CLI moves it: replies, resolves and the reviewers asked for are kept
# beside the JSON, so the next read shows them.
reviews=$(read_key reviews)
reviews=${reviews:-none}
pending_review=$(read_key pendingReview)

# Three review threads, as both hosts print them: an open one with a suggestion on src/cart.ts line 12,
# a resolved one on README.md, and an outdated one whose line moved, with a body that tries HTML
THREAD_1=PRRT_kwDOe2e0001
THREAD_2=PRRT_kwDOe2e0002
THREAD_3=PRRT_kwDOe2e0003
GL_1=1111111111111111111111111111111111111111
GL_2=2222222222222222222222222222222222222222
GL_3=3333333333333333333333333333333333333333
BODY_1='"Round half up here: a float total prints 10.01.\n\n```suggestion\n  return Math.round(total * 100) / 100;\n```"'
BODY_2='"The heading reads fine now."'
BODY_3='"Keep the old helper <img src=x onerror=\"window.__pwned=1\"> **as it was** please"'

# "resolved" or "open": what a resolve or a reopen last said wins over the scenario's own state
thread_state() {
  last=$(grep "^$1 " "$dir/$name.threadstate" 2>/dev/null | tail -n 1 | cut -d' ' -f2)
  echo "${last:-$2}"
}

# The replies a spec posted to a thread, as comments: "<root id> <JSON string>" per line
reply_nodes() {
  n=0
  grep "^$1 " "$dir/$name.replies" 2>/dev/null | cut -d' ' -f2- | while IFS= read -r reply_body; do
    n=$((n + 1))
    if [ "$name" = gh ]; then
      printf ',{"id":"PRRC_reply%s","databaseId":%s,"body":%s,"author":{"login":"%s"},"createdAt":"2026-10-01T10:30:00Z","outdated":false,"diffHunk":"","replyTo":null}' "$n" "$((6000 + n))" "$reply_body" "${user:-octocat}"
    else
      printf ',{"id":%s,"author":{"username":"%s"},"body":%s,"created_at":"2026-10-01T10:30:00Z","system":false,"position":null,"suggestions":null}' "$((6000 + n))" "${user:-tanuki}" "$reply_body"
    fi
  done
}

# ---- gh: the review threads, the reviewers and the reviews ----
gh_thread() {
  # node id, database id, scenario state, outdated, line, original line, body, author
  resolved=false
  [ "$(thread_state "$1" "$3")" = resolved ] && resolved=true
  if [ "$4" = true ]; then line=null; else line=$5; fi
  if [ "$resolved" = true ]; then by='{"login":"hubot"}'; else by=null; fi
  path=src/cart.ts
  [ "$1" = "$THREAD_2" ] && path=README.md
  printf '{"id":"%s","isResolved":%s,"isOutdated":%s,"path":"%s","line":%s,"originalLine":%s,"startLine":null,"originalStartLine":null,"diffSide":"RIGHT","startDiffSide":null,"subjectType":"LINE","resolvedBy":%s,"viewerCanResolve":true,"viewerCanUnresolve":true,"viewerCanReply":true,"comments":{"totalCount":1,"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[{"id":"PRRC_%s","databaseId":%s,"body":%s,"author":{"login":"%s"},"createdAt":"2026-10-01T10:00:00Z","outdated":%s,"diffHunk":"@@ -10,3 +10,3 @@ export function total(items) {\\n-  return sum;\\n+  return sum / 100;\\n }","replyTo":null,"pullRequestReview":{"databaseId":9000,"state":"COMMENTED"}}%s]}}' \
    "$1" "$resolved" "$4" "$path" "$line" "$6" "$by" "$1" "$2" "$7" "$8" "$4" "$(reply_nodes "$2")"
}

threads_json() {
  nodes=""
  count=0
  if [ "$reviews" != none ]; then
    nodes="$(gh_thread $THREAD_1 5001 open false 12 12 "$BODY_1" hubot),$(gh_thread $THREAD_2 5002 resolved false 1 1 "$BODY_2" hubot),$(gh_thread $THREAD_3 5003 open true 20 20 "$BODY_3" hubot)"
    count=3
  fi
  printf 'HTTP/2.0 200 OK\r\nx-ratelimit-remaining: 4990\r\n\r\n'
  printf '{"data":{"rateLimit":{"cost":1,"remaining":4990,"resetAt":"2026-10-01T11:00:00Z","used":10},"repository":{"pullRequest":{"headRefOid":"%s","reviewThreads":{"totalCount":%s,"pageInfo":{"hasNextPage":false,"endCursor":"Y3Vyc29yOjM="},"nodes":[%s]}}}}}\n' "$head_sha" "$count" "$nodes"
}

# resolve (true) or reopen (false) the thread named by -F id=
thread_mutation() {
  want="$1"; shift
  id=$(echo "$*" | sed -n 's/.*-F id=\([A-Za-z0-9_=-]*\).*/\1/p')
  if [ "$want" = true ]; then st=resolved; verb=resolve; else st=open; verb=unresolve; fi
  echo "$id $st" >> "$dir/$name.threadstate"
  printf '{"data":{"%sReviewThread":{"thread":{"id":"%s","isResolved":%s}}}}\n' "$verb" "$id" "$want"
}

# The requested reviewers: the scenario's own first, then whoever a spec asked for
requested_json() {
  list="$1"
  for who in $(cat "$dir/$name.requested" 2>/dev/null); do
    if [ -n "$list" ]; then list="$list,{\"login\":\"$who\"}"; else list="{\"login\":\"$who\"}"; fi
  done
  echo "$list"
}

pr_reviews_json() {
  case "$reviews" in
    threads) decision='"REVIEW_REQUIRED"'; given='[{"author":{"login":"hubot"},"state":"COMMENTED"}]'; first='{"login":"monalisa"}' ;;
    changes) decision='"CHANGES_REQUESTED"'; given='[{"author":{"login":"hubot"},"state":"CHANGES_REQUESTED"}]'; first='{"login":"monalisa"}' ;;
    *) decision='""'; given='[]'; first='' ;;
  esac
  printf '{"reviewDecision":%s,"reviewRequests":[%s],"reviews":%s}\n' "$decision" "$(requested_json "$first")" "$given"
}

# ---- glab: the discussions, the approvals and the reviewers ----
glab_discussion() {
  # discussion id (40 hex), scenario state, new line, head sha the note was left on, body
  resolved=false
  [ "$(thread_state "$1" "$2")" = resolved ] && resolved=true
  path=src/cart.ts
  [ "$1" = "$GL_2" ] && path=README.md
  if [ "$1" = "$GL_1" ]; then
    suggestions='[{"from_line":12,"to_line":12,"from_content":"  return sum / 100;","to_content":"  return Math.round(total * 100) / 100;","appliable":true,"applied":false}]'
  else
    suggestions='[]'
  fi
  printf '{"id":"%s","individual_note":false,"resolvable":true,"resolved":%s,"notes":[{"id":%s,"type":"DiffNote","author":{"username":"hubot"},"body":%s,"created_at":"2026-10-01T10:00:00Z","system":false,"resolved_by":%s,"position":{"new_path":"%s","old_path":"%s","new_line":%s,"old_line":null,"head_sha":"%s","line_range":null},"suggestions":%s}%s]}\n' \
    "$1" "$resolved" "$6" "$5" "$( [ "$resolved" = true ] && echo '{"username":"hubot"}' || echo null )" "$path" "$path" "$3" "$4" "$suggestions" "$(reply_nodes "$1")"
}

# What `mr note publish` made of the draft notes: one discussion per note, in the order they were saved.
# "<discussion id> <note id> <path or -> <new line or -> <head sha> <JSON string>" per line
published_discussions() {
  [ -f "$dir/glab.published" ] || return 0
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    disc=$(printf '%s' "$entry" | cut -d' ' -f1)
    note_id=$(printf '%s' "$entry" | cut -d' ' -f2)
    path=$(printf '%s' "$entry" | cut -d' ' -f3)
    line=$(printf '%s' "$entry" | cut -d' ' -f4)
    at_head=$(printf '%s' "$entry" | cut -d' ' -f5)
    note_body=$(printf '%s' "$entry" | cut -d' ' -f6-)
    if [ "$path" = - ]; then
      position=null
    else
      position="{\"new_path\":\"$path\",\"old_path\":\"$path\",\"new_line\":$line,\"old_line\":null,\"head_sha\":\"$at_head\",\"line_range\":null}"
    fi
    printf '{"id":"%s","individual_note":false,"resolvable":true,"resolved":false,"notes":[{"id":%s,"type":"DiffNote","author":{"username":"%s"},"body":%s,"created_at":"2026-10-01T10:40:00Z","system":false,"resolved_by":null,"position":%s,"suggestions":[]}]}\n' "$disc" "$note_id" "${user:-tanuki}" "$note_body" "$position"
  done < "$dir/glab.published"
}

# The note text of a draft's JSON, still a JSON string
draft_note() {
  printf '%s' "$1" | sed -nE 's/^\{"note":("([^"\\]|\\.)*").*/\1/p'
}

# Draft notes, as GitLab keeps them: "<id> <the JSON the CLI was given>" per line. The person's own
# drafts (not Agentry's) are lines a spec writes there; every draft is listed and published alike
drafts_json() {
  printf '['
  first=1
  if [ -f "$dir/glab.drafts" ]; then
    while IFS= read -r entry; do
      [ -n "$entry" ] || continue
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"id":%s,"note":%s}' "${entry%% *}" "$(draft_note "${entry#* }")"
    done < "$dir/glab.drafts"
  fi
  printf ']\n'
}

# POST draft_notes. `draftFailAfter` N makes the call after the N-th one saved fail, which is how a
# review stops half way with notes still saved on the host
draft_create() {
  body=$(cat)
  made=$(cat "$dir/glab.draftposts" 2>/dev/null || echo 0)
  echo $((made + 1)) > "$dir/glab.draftposts"
  limit=$(read_key draftFailAfter)
  if [ -n "$limit" ] && [ "$made" -ge "$limit" ]; then
    echo "glab: 422 Unprocessable Entity" >&2
    exit 1
  fi
  id=$(cat "$dir/glab.draftseq" 2>/dev/null || echo 7000)
  id=$((id + 1))
  echo "$id" > "$dir/glab.draftseq"
  printf '%s %s\n' "$id" "$body" >> "$dir/glab.drafts"
  line=$(printf '%s' "$body" | sed -n 's/.*"new_line":\([0-9]*\).*/\1/p')
  if [ -n "$line" ]; then
    printf '{"id":%s,"line_code":"e2e_%s_%s","position":{"new_line":%s}}\n' "$id" "$line" "$line" "$line"
  else
    printf '{"id":%s,"line_code":null,"position":null}\n' "$id"
  fi
}

# `mr note publish`: every draft there is becomes a discussion, the first `publishLimit` of them; the
# rest vanish with exit 0, as a note the host cannot place does (recorded)
draft_publish() {
  if [ ! -s "$dir/glab.drafts" ]; then echo "No pending review comments on !$1." >&2; exit 1; fi
  limit=$(read_key publishLimit)
  total=$(grep -c . "$dir/glab.drafts")
  made=0
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    if [ -n "$limit" ] && [ "$made" -ge "$limit" ]; then continue; fi
    made=$((made + 1))
    raw="${entry#* }"
    path=$(printf '%s' "$raw" | sed -n 's/.*"new_path":"\([^"]*\)".*/\1/p')
    line=$(printf '%s' "$raw" | sed -n 's/.*"new_line":\([0-9]*\).*/\1/p')
    at_head=$(printf '%s' "$raw" | sed -n 's/.*"head_sha":"\([0-9a-f]*\)".*/\1/p')
    n=$(grep -c . "$dir/glab.published" 2>/dev/null)
    n=${n:-0}
    printf '%040d %s %s %s %s %s\n' "$((4000 + n))" "${entry%% *}" "${path:--}" "${line:--}" "${at_head:-$head_sha}" "$(draft_note "$raw")" >> "$dir/glab.published"
  done < "$dir/glab.drafts"
  : > "$dir/glab.drafts"
  echo "✓ Published $total pending review comments."
}

discussions_ndjson() {
  published_discussions
  [ "$reviews" = none ] && return
  glab_discussion "$GL_1" open 12 "$head_sha" "$BODY_1" 5001
  glab_discussion "$GL_2" resolved 1 "$head_sha" "$BODY_2" 5002
  # Left on another commit than the head: the thread is outdated
  glab_discussion "$GL_3" open 20 0000000000000000000000000000000000000000 "$BODY_3" 5003
}

# The viewer has approved once `mr approve` ran; the rule wants one approval
approvals_json() {
  if [ -f "$dir/glab.approved" ]; then
    printf '{"approved":true,"approvals_required":1,"approvals_left":0,"user_has_approved":true,"approved_by":[{"user":{"username":"%s"}}]}\n' "${user:-tanuki}"
  else
    echo '{"approved":false,"approvals_required":1,"approvals_left":1,"user_has_approved":false,"approved_by":[]}'
  fi
}

glab_reviewers_json() {
  list=""
  case "$reviews" in
    threads) list='{"user":{"username":"hubot"},"state":"reviewed"},{"user":{"username":"monalisa"},"state":"unreviewed"}' ;;
    changes) list='{"user":{"username":"hubot"},"state":"requested_changes"},{"user":{"username":"monalisa"},"state":"unreviewed"}' ;;
  esac
  for who in $(cat "$dir/$name.requested" 2>/dev/null); do
    if [ -n "$list" ]; then list="$list,{\"user\":{\"username\":\"$who\"},\"state\":\"unreviewed\"}"; else list="{\"user\":{\"username\":\"$who\"},\"state\":\"unreviewed\"}"; fi
  done
  echo "[$list]"
}

# The repository a -R names, as a web address
repo_url() {
  r=$(flag -R "$@")
  case "$r" in http*) echo "$r" ;; *) echo "https://$r" ;; esac
}

# ---- gh: the checks of a head commit, as the REST and GraphQL answers print them ----
check_run() {
  # id name status conclusion app
  if [ -n "$4" ]; then conclusion="\"$4\""; else conclusion=null; fi
  if [ "$3" = completed ]; then done_at='"2026-10-01T09:53:12Z"'; else done_at=null; fi
  printf '{"id":%s,"name":"%s","status":"%s","conclusion":%s,"app":{"slug":"%s"},"html_url":"https://github.com/acme/shop/actions/runs/900/job/%s","started_at":"2026-10-01T09:50:00Z","completed_at":%s}' \
    "$1" "$2" "$3" "$conclusion" "$5" "$1" "$done_at"
}

check_runs_json() {
  case "$checks" in
    failing) list="$(check_run 1001 lint completed success github-actions),$(check_run 1002 unit completed failure github-actions),$(check_run 1003 build completed success github-actions)"; total=3 ;;
    running) list="$(check_run 1001 lint completed success github-actions),$(check_run 1003 e2e in_progress '' github-actions),$(check_run 1004 build queued '' github-actions)"; total=3 ;;
    both) list="$(check_run 1001 lint completed failure github-actions),$(check_run 1002 unit completed failure github-actions),$(check_run 1003 build completed success github-actions)"; total=3 ;;
    mixed) list="$(check_run 1001 lint completed success github-actions),$(check_run 1002 unit completed failure github-actions),$(check_run 1003 e2e in_progress '' github-actions),$(check_run 1004 docs completed skipped github-actions),$(check_run 1005 coverage completed success codecov)"; total=5 ;;
    fixed) list="$(check_run 1001 lint completed success github-actions),$(check_run 1002 unit completed success github-actions),$(check_run 1003 build completed success github-actions)"; total=3 ;;
    *) list=""; total=0 ;;
  esac
  printf '[{"total_count":%s,"check_runs":[%s]}]\n' "$total" "$list"
}

# What the GraphQL read says of the head commit's rollup, in the shape the CI badge reads
rollup_nodes() {
  case "$checks" in
    failing|mixed|both) echo '{"__typename":"CheckRun","name":"unit","status":"COMPLETED","conclusion":"FAILURE"}' ;;
    running) echo '{"__typename":"CheckRun","name":"e2e","status":"IN_PROGRESS","conclusion":null}' ;;
    fixed) echo '{"__typename":"CheckRun","name":"unit","status":"COMPLETED","conclusion":"SUCCESS"}' ;;
  esac
}

change_request_json() {
  nodes=$(rollup_nodes)
  rollup=null
  [ -n "$nodes" ] && rollup="{\"state\":\"PENDING\",\"contexts\":{\"nodes\":[$nodes],\"pageInfo\":{\"hasNextPage\":false}}}"
  case "$mr_state" in merged) st=MERGED; at='"2026-10-01T10:00:00Z"' ;; closed) st=CLOSED; at=null ;; *) st=OPEN; at=null ;; esac
  number=$(echo "$*" | sed -n 's/.*number=\([0-9]*\).*/\1/p')
  printf 'HTTP/2.0 200 OK\r\nx-ratelimit-remaining: 4990\r\n\r\n'
  printf '{"data":{"repository":{"pullRequest":{"number":%s,"url":"https://github.com/acme/shop/pull/%s","state":"%s","mergedAt":%s,"isDraft":false,"headRefOid":"%s","baseRefName":"main","mergeable":"MERGEABLE","mergeStateStatus":"CLEAN","reviewDecision":null,"autoMergeRequest":null,"commits":{"nodes":[{"commit":{"statusCheckRollup":%s}}]}}},"rateLimit":{"cost":1,"remaining":4990,"resetAt":"2026-10-01T11:00:00Z"}}}\n' "${number:-7}" "${number:-7}" "$st" "$at" "$head_sha" "$rollup"
}

# The failed job prints what a runner prints: ANSI colour, a group marker, the error line
job_log() {
  printf '2026-10-01T09:50:01Z \033[36;1m##[group]Run pnpm test\033[0m\n'
  printf '2026-10-01T09:50:02Z \033[90m$ node --test test/*.test.ts\033[0m\n'
  printf '2026-10-01T09:50:09Z ok 41 - cart totals\n'
  printf '2026-10-01T09:50:10Z \033[31mnot ok 42 - cart rounds half up\033[0m\n'
  printf '2026-10-01T09:50:10Z   AssertionError: expected 10.01 to equal 10.02\n'
  printf '2026-10-01T09:50:11Z \033[31;1m##[error]Process completed with exit code 1.\033[0m\n'
}

# Only the failed run carries annotations: once it passes (same id, as the fixed scenario keeps it)
# a real host has none for it
annotations_json() {
  case "$checks" in failing|mixed|both) ;; *) echo '[]'; return ;; esac
  echo '[{"path":".github","start_line":1,"end_line":1,"annotation_level":"failure","title":null,"message":"Process completed with exit code 1."},{"path":"src/cart.ts","start_line":12,"end_line":12,"annotation_level":"failure","title":"cart rounds half up","message":"expected 10.01 to equal 10.02"}]'
}

# ---- gh: what the merge routes read and write ----
gh_rules_json() {
  required=$(read_key requiredChecks)
  if [ -z "$required" ]; then echo '[]'; return; fi
  list=""
  for context in $required; do
    [ -n "$list" ] && list="$list,"
    list="$list{\"context\":\"$context\"}"
  done
  printf '[{"type":"required_status_checks","parameters":{"required_status_checks":[%s]}}]\n' "$list"
}

# `pr view --json id,number,url,state,isDraft,headRefOid,…,autoMergeRequest`
gh_merge_view() {
  number="$1"; shift
  status=$(read_key mergeStatus)
  status=${status:-CLEAN}
  case "$status" in DIRTY) mergeable=CONFLICTING ;; UNKNOWN) mergeable=UNKNOWN ;; *) mergeable=MERGEABLE ;; esac
  draft=false
  [ "$(read_key draft)" = true ] && draft=true
  decision=$(read_key reviewDecision)
  if [ -n "$decision" ]; then decision="\"$decision\""; else decision=null; fi
  method=$(armed_method)
  if [ -n "$method" ]; then
    auto="{\"mergeMethod\":\"$method\",\"enabledBy\":{\"login\":\"${user:-octocat}\"},\"enabledAt\":\"2026-10-01T10:00:00Z\"}"
  else
    auto=null
  fi
  case "$mr_state" in merged) st=MERGED ;; closed) st=CLOSED ;; *) st=OPEN ;; esac
  printf '{"id":"PR_kwDOe2e%04d","number":%s,"url":"%s/pull/%s","state":"%s","isDraft":%s,"headRefOid":"%s","headRefName":"task/e2e","baseRefName":"main","mergeable":"%s","mergeStateStatus":"%s","reviewDecision":%s,"autoMergeRequest":%s}\n' \
    "$number" "$number" "$(repo_url "$@")" "$number" "$st" "$draft" "$head_sha" "$mergeable" "$status" "$decision" "$auto"
}

# `pr merge`: the head guard is the CLI's own (--match-head-commit), the refusal is gh's first line
gh_merge() {
  case "$*" in
    *--disable-auto*) rm -f "$dir/gh.armed"; exit 0 ;;
  esac
  want=$(flag --match-head-commit "$@")
  if [ -n "$want" ] && [ "$want" != "$head_sha" ]; then
    echo "GraphQL: Head branch was modified. Review and try the merge again. (mergePullRequest)" >&2
    exit 1
  fi
  case "$*" in *--body-file*) cat > "$dir/gh.merge-body" ;; esac
  echo "$3" > "$dir/gh.merged-of"
  case "$*" in *--squash*) echo squash > "$dir/gh.merged" ;; *--rebase*) echo rebase > "$dir/gh.merged" ;; *) echo merge > "$dir/gh.merged" ;; esac
  rm -f "$dir/gh.armed"
  echo "✓ Merged pull request #$3"
  exit 0
}

# The arming mutation: the repository's setting and the expected head are checked as gh's server does
gh_arm() {
  method=$(echo "$*" | sed -n 's/.*-f m=\([A-Z]*\).*/\1/p')
  oid=$(echo "$*" | sed -n 's/.*-f oid=\([0-9a-f]*\).*/\1/p')
  if [ "$(read_key autoMergeAllowed)" = false ]; then
    echo '{"errors":[{"message":"Auto merge is not allowed for this repository"}]}'
    exit 1
  fi
  if [ -n "$oid" ] && [ "$oid" != "$head_sha" ]; then
    echo '{"errors":[{"message":"the expected head oid does not match the pull request head"}]}'
    exit 1
  fi
  echo "$method" > "$dir/gh.armed"
  printf '{"data":{"enablePullRequestAutoMerge":{"pullRequest":{"autoMergeRequest":{"mergeMethod":"%s"}}}}}\n' "$method"
  exit 0
}

# ---- glab: what the merge routes read and write ----
glab_merge_view() {
  number="$1"; shift
  case "$ci" in none) pipe=null ;; passing) pipe="{\"id\":501,\"status\":\"success\",\"sha\":\"$head_sha\"}" ;; failing) pipe="{\"id\":501,\"status\":\"failed\",\"sha\":\"$head_sha\"}" ;; *) pipe="{\"id\":501,\"status\":\"running\",\"sha\":\"$head_sha\"}" ;; esac
  case "$mr_state" in merged) st=merged; at='"2026-10-01T10:00:00Z"' ;; closed) st=closed; at=null ;; *) st=opened; at=null ;; esac
  detail=$(read_key mergeDetail)
  detail=${detail:-mergeable}
  [ -f "$dir/glab.rebased" ] && detail=mergeable
  draft=false
  [ "$(read_key draft)" = true ] && draft=true
  conflicts=false
  [ "$detail" = conflict ] && conflicts=true
  method=$(armed_method)
  if [ -n "$method" ]; then
    armed=true
    merge_user="{\"username\":\"${user:-tanuki}\"}"
  else
    armed=false
    merge_user=null
  fi
  squash=false
  [ "$method" = squash ] && squash=true
  printf '{"iid":%s,"web_url":"%s/-/merge_requests/%s","state":"%s","merged_at":%s,"draft":%s,"detailed_merge_status":"%s","has_conflicts":%s,"head_pipeline":%s,"sha":"%s","source_branch":"task/e2e","target_branch":"main","merge_when_pipeline_succeeds":%s,"merge_user":%s,"squash":%s,"merge_error":null,"diff_refs":{"base_sha":"%s","start_sha":"%s","head_sha":"%s"}}\n' \
    "$number" "$(repo_url "$@")" "$number" "$st" "$at" "$draft" "$detail" "$conflicts" "$pipe" "$head_sha" "$armed" "$merge_user" "$squash" "$head_sha" "$head_sha" "$head_sha"
}

# `mr merge`: --auto-merge arms, --auto-merge=false merges now; a head that is not the one asked for
# is refused in the boxed stderr glab prints (the 409 is the only status it says)
glab_merge() {
  want=$(flag --sha "$@")
  if [ -n "$want" ] && [ "$want" != "$head_sha" ]; then
    echo "All attempts fail: 409 {message: SHA does not match HEAD of source branch}" >&2
    exit 1
  fi
  case "$*" in
    *--auto-merge=false*) ;;
    *--auto-merge*)
      case "$*" in *--squash*) echo squash > "$dir/glab.armed" ;; *) echo merge > "$dir/glab.armed" ;; esac
      echo "✓ Auto-merge enabled for !$3"
      exit 0 ;;
  esac
  echo "$3" > "$dir/glab.merged-of"
  echo merge > "$dir/glab.merged"
  rm -f "$dir/glab.armed"
  echo "✓ Merged !$3"
  exit 0
}

# ---- Issues: what the trackers (GitHub Issues, GitLab Issues) read and write ----
# One line per issue, `number|title|labels (comma list)|body (a JSON string)`. The bodies are a
# stranger's text on purpose: one tries HTML and a closing word, one is empty. A close the CLI took is
# kept in `<name>.issues-closed` (one number per line), so every read after it says closed
issue_lines() {
  case "$name" in
    gh)
      printf '%s\n' \
        '31|Cart total rounds half down|bug|"The cart total shows 10.01 where 10.02 is expected.\n\nSteps:\n1. Add two items\n2. Open the cart\n\n<img src=x onerror=\"window.__pwned=1\"> Closes #99"' \
        '32|Add a coupon field to the checkout|enhancement|"Add a coupon code field to the checkout form.\n\nAcceptance: the total updates when a valid code is applied."' \
        '33|Checkout crashes on an empty cart|bug|"Opening the checkout with no items throws a TypeError."' \
        '34|Support gift wrapping <b>now</b>||""'
      ;;
    glab)
      printf '%s\n' \
        '41|Webhook retries never stop|bug|"A failed webhook is retried forever.\n\n<script>window.__pwned=1</script>"' \
        '42|Export orders as CSV|enhancement|"Orders should download as a CSV file."'
      ;;
  esac
}

issue_closed() {
  grep -qx "$1" "$dir/$name.issues-closed" 2>/dev/null
}

issue_json() {
  num="$1"; title="$2"; labels="$3"; body="$4"
  names=""
  for label in $(echo "$labels" | tr ',' ' '); do
    [ -n "$names" ] && names="$names,"
    if [ "$name" = gh ]; then names="$names{\"name\":\"$label\"}"; else names="$names\"$label\""; fi
  done
  if [ "$name" = gh ]; then
    if issue_closed "$num"; then st=CLOSED; why=COMPLETED; else st=OPEN; why=""; fi
    printf '{"number":%s,"title":"%s","body":%s,"state":"%s","stateReason":"%s","labels":[%s],"url":"https://github.com/acme/shop/issues/%s","updatedAt":"2026-10-01T09:00:00Z","closedByPullRequestsReferences":[]}' \
      "$num" "$title" "$body" "$st" "$why" "$names" "$num"
  else
    if issue_closed "$num"; then st=closed; else st=opened; fi
    printf '{"iid":%s,"id":90000%s,"title":"%s","description":%s,"state":"%s","labels":[%s],"web_url":"https://gitlab.com/acme/shop/-/work_items/%s","updated_at":"2026-10-01T09:00:00Z"}' \
      "$num" "$num" "$title" "$body" "$st" "$names" "$num"
  fi
}

# GitHub's search words as far as the specs use them: `is:open`, `label:x`, and plain words in the title
issue_matches() {
  for term in $3; do
    case "$term" in
      is:*) ;;
      label:*) case ",$2," in *",${term#label:},"*) ;; *) return 1 ;; esac ;;
      *) echo "$1" | grep -qiF -- "$term" || return 1 ;;
    esac
  done
  return 0
}

# The open issues that match the search; gh has no page (it cuts the page out of one long list), glab
# has one page of them
issue_list() {
  search="$1"
  page="$2"
  if [ "${page:-1}" != 1 ]; then echo '[]'; return; fi
  printf '['
  sep=""
  issue_lines | while IFS='|' read -r n title labels body; do
    issue_closed "$n" && continue
    issue_matches "$title" "$labels" "$search" || continue
    printf '%s' "$sep"
    issue_json "$n" "$title" "$labels" "$body"
    sep=","
  done
  printf ']\n'
}

issue_view() {
  line=$(issue_lines | grep "^$1|")
  if [ -z "$line" ]; then
    if [ "$name" = gh ]; then echo "GraphQL: Could not resolve to an issue or pull request with the number of $1. (repository.issue)" >&2; else echo "404 Not Found" >&2; fi
    exit 1
  fi
  IFS='|' read -r n title labels body <<EOT
$line
EOT
  issue_json "$n" "$title" "$labels" "$body"
  echo
}

# `issueWriteFail: true` makes the write fail the way a host that is down does, so a sync fails for real
issue_close() {
  if [ "$(read_key issueWriteFail)" = true ]; then
    echo "fake $name: HTTP 500 Internal Server Error" >&2
    exit 1
  fi
  echo "$1" >> "$dir/$name.issues-closed"
  echo "✓ Closed issue #$1"
}

# gh's repository webhooks (`gh api repos/<o>/<n>/hooks…`), as recorded: the secret comes back as
# `********`, a ping answers empty and makes the hook's `last_response` `204 active` (or `502
# connection_error` while `hookPing` is `fail`), and a delete of a hook that is gone is a 404. A hook is
# a file beside the JSON, `gh.hook-<id>`: its address on the first line, `<code> <status>` of its last
# delivery on the second (`null unused` before any). The secret the CLI was given on stdin is kept in
# `gh.hook-<id>.secret`, which only a spec reads, so it can sign what the host would deliver.
hook_events='"pull_request","pull_request_review","pull_request_review_comment","pull_request_review_thread","check_run","check_suite","workflow_run","issue_comment","issues"'
hook_json() {
  f="$dir/gh.hook-$1"
  resp=$(sed -n 2p "$f")
  code=${resp%% *}
  printf '{"type":"Repository","id":%s,"name":"web","active":true,"events":[%s],"config":{"content_type":"json","insecure_ssl":"0","secret":"********","url":"%s"},"last_response":{"code":%s,"status":"%s","message":null}}' \
    "$1" "$hook_events" "$(sed -n 1p "$f")" "$code" "${resp#* }"
}
hook_missing() {
  echo '{"message":"Not Found","status":"404"}'
  echo "gh: Not Found (HTTP 404)" >&2
  exit 1
}
gh_hooks() {
  method=$(flag -X "$@")
  tail=$(echo "$*" | grep -o 'hooks[^ ]*' | head -n 1)
  id=$(echo "$tail" | sed -n 's#^hooks/\([0-9]*\).*#\1#p')
  sub=$(echo "$tail" | sed -n 's#^hooks/[0-9]*/\(.*\)#\1#p')
  if [ -z "$id" ]; then
    case "$method" in
      POST)
        body=$(cat)
        n=$(cat "$dir/gh.hookseq" 2>/dev/null || echo 9000)
        n=$((n + 1))
        echo "$n" > "$dir/gh.hookseq"
        printf '%s\n%s\n' "$(echo "$body" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')" 'null unused' > "$dir/gh.hook-$n"
        echo "$body" | sed -n 's/.*"secret":"\([^"]*\)".*/\1/p' > "$dir/gh.hook-$n.secret"
        hook_json "$n"; echo; exit 0 ;;
      *)
        printf '['
        sep=
        for f in "$dir"/gh.hook-[0-9]*; do
          [ -f "$f" ] || continue
          case "$f" in *.secret) continue ;; esac
          printf '%s' "$sep"; hook_json "${f##*gh.hook-}"; sep=,
        done
        echo ']'; exit 0 ;;
    esac
  fi
  [ -f "$dir/gh.hook-$id" ] || hook_missing
  case "$method:$sub" in
    DELETE:) rm -f "$dir/gh.hook-$id" "$dir/gh.hook-$id.secret"; exit 0 ;;
    POST:pings)
      if [ "$(read_key hookPing)" = fail ]; then resp='502 connection_error'; else resp='204 active'; fi
      printf '%s\n%s\n' "$(sed -n 1p "$dir/gh.hook-$id")" "$resp" > "$dir/gh.hook-$id"
      exit 0 ;;
    PATCH:config)
      body=$(cat)
      printf '%s\n%s\n' "$(echo "$body" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')" "$(sed -n 2p "$dir/gh.hook-$id")" > "$dir/gh.hook-$id"
      printf '{"content_type":"json","insecure_ssl":"0","secret":"********","url":"%s"}\n' "$(sed -n 1p "$dir/gh.hook-$id")"; exit 0 ;;
    *:) hook_json "$id"; echo; exit 0 ;;
  esac
  echo "fake $name: hooks call is not part of the fake: $*" >&2
  exit 1
}

# glab's project hooks (`glab api -i projects/<id>/hooks…`), as recorded by w0: the token is never
# read back (`token_present`), the test endpoint delivers once and the hook's newest event says how
# it was answered (`204`, or `internal error` while `hookPing` is `fail`), and a call on a hook that is
# gone is a 404 whose status line only `-i` prints. A hook is a file beside the JSON, `glab.hook-<id>`:
# its address on the first line, the newest event (`<event id> <response status>`, empty before any)
# on the second. The token the CLI was given on stdin is kept in `glab.hook-<id>.secret`, which only a
# spec reads, so it can sign what the host would deliver.
glab_hook_json() {
  alert=$(read_key hookAlert)
  printf '{"id":%s,"url":"%s","name":"agentry","alert_status":"%s","token_present":true,"signing_token_present":true}' \
    "$1" "$(sed -n 1p "$dir/glab.hook-$1")" "${alert:-executable}"
}
glab_hook_missing() {
  printf 'HTTP/2.0 404 Not Found\n\n{"message":"404 Not found"}\n'
  echo "glab: 404 Not found (HTTP 404)" >&2
  exit 1
}
glab_hooks() {
  method=$(flag -X "$@")
  tail=$(echo "$*" | grep -o 'hooks[^ ]*' | head -n 1)
  id=$(echo "$tail" | sed -n 's#^hooks/\([0-9]*\).*#\1#p')
  sub=$(echo "$tail" | sed -n 's#^hooks/[0-9]*/\(.*\)#\1#p')
  if [ -z "$id" ]; then
    case "$method" in
      POST)
        body=$(cat)
        n=$(cat "$dir/glab.hookseq" 2>/dev/null || echo 7000)
        n=$((n + 1))
        echo "$n" > "$dir/glab.hookseq"
        printf '%s\n\n' "$(echo "$body" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')" > "$dir/glab.hook-$n"
        echo "$body" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p' > "$dir/glab.hook-$n.secret"
        glab_hook_json "$n"; echo; exit 0 ;;
      *)
        printf '['
        sep=
        for f in "$dir"/glab.hook-[0-9]*; do
          [ -f "$f" ] || continue
          case "$f" in *.secret) continue ;; esac
          printf '%s' "$sep"; glab_hook_json "${f##*glab.hook-}"; sep=,
        done
        echo ']'; exit 0 ;;
    esac
  fi
  [ -f "$dir/glab.hook-$id" ] || glab_hook_missing
  case "$method:$sub" in
    DELETE:) rm -f "$dir/glab.hook-$id" "$dir/glab.hook-$id.secret"; exit 0 ;;
    POST:test/push_events)
      seq=$(cat "$dir/glab.eventseq" 2>/dev/null || echo 27000)
      seq=$((seq + 1))
      echo "$seq" > "$dir/glab.eventseq"
      if [ "$(read_key hookPing)" = fail ]; then resp='internal error'; else resp=204; fi
      printf '%s\n%s %s\n' "$(sed -n 1p "$dir/glab.hook-$id")" "$seq" "$resp" > "$dir/glab.hook-$id"
      echo '{"message":"201 Created"}'; exit 0 ;;
    POST:test/*) echo '{"message":"Ensure the project has merge requests."}'; echo "glab: Ensure the project has merge requests. (HTTP 422)" >&2; exit 1 ;;
    PUT:)
      body=$(cat)
      printf '%s\n%s\n' "$(echo "$body" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p')" "$(sed -n 2p "$dir/glab.hook-$id")" > "$dir/glab.hook-$id"
      token=$(echo "$body" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
      [ -n "$token" ] && echo "$token" > "$dir/glab.hook-$id.secret"
      glab_hook_json "$id"; echo; exit 0 ;;
    GET:events*|:events*)
      last=$(sed -n 2p "$dir/glab.hook-$id")
      if [ -z "$last" ]; then echo '[]'; exit 0; fi
      printf '[{"id":%s,"trigger":"push_hooks","response_status":' "${last%% *}"
      case "${last#* }" in 204) printf '204' ;; *) printf '"%s"' "${last#* }" ;; esac
      echo '}]'; exit 0 ;;
    :|GET:) glab_hook_json "$id"; echo; exit 0 ;;
  esac
  echo "fake $name: hooks call is not part of the fake: $*" >&2
  exit 1
}

version_out() {
  code=$(read_key versionExit)
  if [ -n "$code" ] && [ "$code" != 0 ]; then echo "fake $name: broken" >&2; exit "$code"; fi
  case "$name" in
    gh) printf 'gh version %s (2026-04-28)\nhttps://github.com/cli/cli/releases/tag/v%s\n' "$version" "$version" ;;
    glab) printf 'glab %s (fake)\n' "$version" ;;
  esac
  exit 0
}

case "$name" in
  gh)
    case "$1" in
      --version) version_out ;;
      auth)
        # One call lists every host and exits 0 whatever the token's state, as 2.92 does
        if [ "$signed_in" = false ]; then echo '{"hosts":{}}'; exit 0; fi
        printf '{"hosts":{"github.com":[{"state":"success","active":true,"host":"github.com","login":"%s","tokenSource":"keyring","gitProtocol":"https"}]}}\n' "${user:-octocat}"
        exit 0 ;;
      api)
        case "$*" in
          *repos/*/hooks|*repos/*/hooks\ *|*repos/*/hooks/*) gh_hooks "$@" ;;
          *enablePullRequestAutoMerge*) gh_arm "$@" ;;
          *unresolveReviewThread*) thread_mutation false "$@"; exit 0 ;;
          *resolveReviewThread*) thread_mutation true "$@"; exit 0 ;;
          *'reviewThreads(first'*) threads_json; exit 0 ;;
          *graphql*) change_request_json "$@"; exit 0 ;;
          */pulls/*/comments/*/replies*)
            root=$(echo "$*" | sed -n 's#.*/comments/\([0-9]*\)/replies.*#\1#p')
            # printf, not echo: a dash echo turns the \n of the JSON string into a line break
            printf '%s %s\n' "$root" "$(cat | sed -n 's/^{"body":\(.*\)}$/\1/p')" >> "$dir/gh.replies"
            printf '{"id":6000}\n'; exit 0 ;;
          */pulls/*/requested_reviewers*)
            # The author cannot be asked (a 422 that names it); an unknown login exits 0 and adds nobody
            for who in $(cat | grep -o '"[A-Za-z0-9][A-Za-z0-9-]*"' | tr -d '"' | grep -v '^reviewers$'); do
              if [ "$who" = "${user:-octocat}" ]; then
                echo '{"message":"Review cannot be requested from pull request author.","status":"422"}'
                echo "gh: Review cannot be requested from pull request author. (HTTP 422)" >&2
                exit 1
              fi
              case "$who" in ghost*) ;; *) echo "$who" >> "$dir/gh.requested" ;; esac
            done
            echo '{}'; exit 0 ;;
          */pulls/*/reviews*)
            case "$*" in
              *"-X POST"*)
                k=$(cat "$dir/gh.reviews-posted" 2>/dev/null || echo 0)
                k=$((k + 1))
                echo "$k" > "$dir/gh.reviews-posted"
                cat > "$dir/gh.review-$k"
                printf '{"id":%s,"state":"COMMENTED"}\n' "$((9000 + k))"; exit 0 ;;
            esac
            # A review of the person's own that is still pending is in the way of a post
            if [ "$pending_review" = true ]; then echo '[[{"id":8001,"state":"PENDING","body":"","user":{"login":"octocat"}}]]'; else echo '[[]]'; fi
            exit 0 ;;
          */check-runs/*/annotations*) annotations_json; exit 0 ;;
          */check-runs\?*) check_runs_json; exit 0 ;;
          */commits/*/status\?*) echo '[{"statuses":[]}]'; exit 0 ;;
          */actions/jobs/*/logs) job_log; exit 0 ;;
          */rules/branches/*) gh_rules_json; exit 0 ;;
          */branches/*) echo '{"protected":false}'; exit 0 ;;
        esac
        # The repository's merge settings ride on the call that names the default branch
        auto_allowed=true
        [ "$(read_key autoMergeAllowed)" = false ] && auto_allowed=false
        delete_on_merge=false
        [ "$(read_key deleteBranchOnMerge)" = true ] && delete_on_merge=true
        printf '{"default_branch":"%s","private":true,"allow_squash_merge":%s,"allow_merge_commit":%s,"allow_rebase_merge":%s,"allow_auto_merge":%s,"delete_branch_on_merge":%s}\n' \
          "$branch" "$(allows squash)" "$(allows merge)" "$(allows rebase)" "$auto_allowed" "$delete_on_merge"; exit 0 ;;
      issue)
        case "$2" in
          list) issue_list "$(flag --search "$@")" 1; exit 0 ;;
          view) issue_view "$3"; exit 0 ;;
          close) issue_close "$3"; exit 0 ;;
        esac ;;
      run)
        # A rerun starts the checks again, a cancel leaves the failure standing
        case "$2" in
          rerun) echo running > "$dir/gh.checks"; exit 0 ;;
          cancel) echo failing > "$dir/gh.checks"; exit 0 ;;
        esac ;;
      pr)
        case "$2" in
          create)
            cat > "$dir/gh.body-$next"
            echo "$next" > "$dir/gh.created"
            echo $((next + 1)) > "$dir/gh.next"
            echo "$(repo_url "$@")/pull/$next"; exit 0 ;;
          list)
            n=$(cat "$dir/gh.created" 2>/dev/null)
            if [ -n "$n" ]; then printf '[{"number":%s,"url":"%s/pull/%s","state":"OPEN","headRefName":"x","baseRefName":"x","isCrossRepository":false}]\n' "$n" "$(repo_url "$@")" "$n"
            else echo '[]'; fi
            exit 0 ;;
          merge) gh_merge "$@" ;;
          view)
            case "$*" in *reviewRequests*) pr_reviews_json; exit 0 ;; esac
            case "$*" in *autoMergeRequest*) gh_merge_view "$3" "$@"; exit 0 ;; esac
            case "$ci" in passing) roll='[{"status":"COMPLETED","conclusion":"SUCCESS"}]' ;; failing) roll='[{"status":"COMPLETED","conclusion":"FAILURE"}]' ;; pending) roll='[{"status":"IN_PROGRESS","conclusion":""}]' ;; *) roll='[]' ;; esac
            case "$mr_state" in merged) st=MERGED; at='"2026-10-01T10:00:00Z"' ;; closed) st=CLOSED; at=null ;; *) st=OPEN; at=null ;; esac
            printf '{"state":"%s","mergedAt":%s,"statusCheckRollup":%s,"url":"%s/pull/%s"}\n' "$st" "$at" "$roll" "$(repo_url "$@")" "$3"; exit 0 ;;
        esac ;;
    esac ;;
  glab)
    case "$1 $2" in
      "version "*|"--version "*) version_out ;;
      "auth status")
        if [ "$signed_in" = false ]; then echo "x No token found" >&2; exit 1; fi
        echo "Logged in to $(flag --hostname "$@") as ${user:-tanuki} (fake)" >&2; exit 0 ;;
      "repo view")
        remove_source=false
        [ "$(read_key deleteBranchOnMerge)" = true ] && remove_source=true
        strategy=$(read_key mergeMethod)
        squash_option=$(read_key squashOption)
        printf '{"id":4242,"default_branch":"%s","visibility":"private","merge_method":"%s","squash_option":"%s","remove_source_branch_after_merge":%s,"only_allow_merge_if_pipeline_succeeds":false,"merge_trains_enabled":false,"ci_config_path":""}\n' \
          "$branch" "${strategy:-merge}" "${squash_option:-default_off}" "$remove_source"; exit 0 ;;
      "issue list") issue_list "$(flag --search "$@")" "$(flag -p "$@")"; exit 0 ;;
      "issue view") issue_view "$3"; exit 0 ;;
      "issue close") issue_close "$3"; exit 0 ;;
      "mr create")
        cat > "$dir/glab.body-$next"
        echo "$next" > "$dir/glab.created"
        echo $((next + 1)) > "$dir/glab.next"
        echo "$(repo_url "$@")/-/merge_requests/$next"; exit 0 ;;
      "mr list")
        n=$(cat "$dir/glab.created" 2>/dev/null)
        if [ -n "$n" ]; then printf '[{"iid":%s,"web_url":"%s/-/merge_requests/%s","state":"opened"}]\n' "$n" "$(repo_url "$@")" "$n"
        else echo '[]'; fi
        exit 0 ;;
      "mr merge") glab_merge "$@" ;;
      "mr rebase") touch "$dir/glab.rebased"; echo "✓ Rebase successful"; exit 0 ;;
      "mr view") glab_merge_view "$3" "$@"; exit 0 ;;
      "mr approve") touch "$dir/glab.approved"; echo "- Approving merge request !$3"; exit 0 ;;
      "mr revoke") rm -f "$dir/glab.approved"; echo "- Revoking approval for merge request !$3"; exit 0 ;;
      "mr update")
        # --reviewer=+name adds one name, --reviewer=-name takes one off; an unknown user fails in glab
        case "$*" in
          *--reviewer=+ghost*) echo "glab: 404 user not found" >&2; exit 1 ;;
          *--reviewer=+*) echo "$(echo "$*" | sed -n 's/.*--reviewer=+\([A-Za-z0-9._-]*\).*/\1/p')" >> "$dir/glab.requested" ;;
          *--reviewer=-*) who=$(echo "$*" | sed -n 's/.*--reviewer=-\([A-Za-z0-9._-]*\).*/\1/p'); grep -v "^$who\$" "$dir/glab.requested" > "$dir/glab.requested.tmp" 2>/dev/null; mv "$dir/glab.requested.tmp" "$dir/glab.requested" 2>/dev/null ;;
        esac
        exit 0 ;;
      "mr note")
        case "$3" in
          resolve) echo "$5 resolved" >> "$dir/glab.threadstate"; exit 0 ;;
          reopen) echo "$5 open" >> "$dir/glab.threadstate"; exit 0 ;;
          publish) draft_publish "$4"; exit 0 ;;
        esac ;;
      "api "*)
        case "$*" in
          */hooks|*/hooks\ *|*/hooks\?*|*/hooks/*) glab_hooks "$@" ;;
          *cancel_merge_when_pipeline_succeeds*) rm -f "$dir/glab.armed"; echo '{"id":1,"iid":7}'; exit 0 ;;
          *include_rebase_in_progress*) echo '{"iid":7,"rebase_in_progress":false,"merge_error":null}'; exit 0 ;;
          */discussions/*/notes*)
            root=$(echo "$*" | sed -n 's#.*/discussions/\([0-9a-f]*\)/notes.*#\1#p')
            printf '%s %s\n' "$root" "$(cat | sed -n 's/^{"body":\(.*\)}$/\1/p')" >> "$dir/glab.replies"
            printf '{"id":6000}\n'; exit 0 ;;
          */discussions*) discussions_ndjson; exit 0 ;;
          */approvals*) approvals_json; exit 0 ;;
          */reviewers*) glab_reviewers_json; exit 0 ;;
          */draft_notes/*)
            case "$*" in
              *"-X DELETE"*)
                gone=$(echo "$*" | sed -n 's#.*/draft_notes/\([0-9]*\).*#\1#p')
                grep -v "^$gone " "$dir/glab.drafts" > "$dir/glab.drafts.tmp" 2>/dev/null
                mv "$dir/glab.drafts.tmp" "$dir/glab.drafts" 2>/dev/null
                exit 0 ;;
            esac ;;
          */draft_notes*)
            case "$*" in *"-X POST"*) draft_create; exit 0 ;; esac
            drafts_json; exit 0 ;;
          # The merge request itself, read the way the core reads it: its REST body, with the merge status asked for again
          */merge_requests/[0-9]|*/merge_requests/[0-9]\?*) glab_merge_view "$(echo "$*" | sed -n 's#.*/merge_requests/\([0-9]*\).*#\1#p')" "$@"; exit 0 ;;
        esac ;;
    esac ;;
esac
echo "fake $name: $* is not part of the fake" >&2
exit 1
