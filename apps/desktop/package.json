{
  "name": "@agentry/desktop",
  "version": "0.34.0",
  "private": true,
  "description": "Electron desktop shell for Agentry",
  "homepage": "https://github.com/yeyo11/agentry",
  "license": "MIT",
  "author": {
    "name": "Jose Antonio Garrido",
    "email": "yeyochico@gmail.com"
  },
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "pnpm --filter @agentry/web build && pnpm --filter @agentry/api bundle && pnpm run build && electron . --dev --no-sandbox",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-timeout=240000 --test-force-exit test/*.test.ts",
    "dist:linux": "pnpm --filter @agentry/web build && pnpm --filter @agentry/api bundle && pnpm run build && electron-builder --linux --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@agentry/core": "workspace:*",
    "electron-updater": "^6.8.9"
  }
}
