+/** `?context=full` or a number of lines; anything else is the default of three. */
+function contextOf(value: string | undefined): DiffContext {
+  if (value === 'full') return 'full';
+  const lines = Number(value);
+  return Number.isInteger(lines) && lines >= 0 ? lines : 3;
+}
 
